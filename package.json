{
  "name": "mindtrace",
  "version": "1.0.0",
  "private": true,
  "description": "MindTrace Chrome Extension — local semantic embeddings",
  "scripts": {
    "build": "node scripts/build-embedding.mjs",
    "build:graph": "node scripts/build-graph.mjs",
    "build:all": "node scripts/build-all.mjs",
    "pack": "node scripts/pack-extension.mjs",
    "release": "npm run build:all && npm run pack",
    "postinstall": "npm run build:all"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph": "^1.47.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
